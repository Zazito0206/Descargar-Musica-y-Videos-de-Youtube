# En el servidor Docker y en Vercel: el mismo secreto aleatorio de 32 caracteres o mas.
BACKEND_TOKEN=
# En ambos: clave privada para entrar a la web (minimo 12 caracteres).
APP_PASSWORD=
# Solo en Vercel: URL HTTPS publica del servidor Docker, sin / final.
BACKEND_URL=
# Solo en el servidor Docker: la misma URL publica.
PUBLIC_URL=
# Solo para iniciar localmente con npm start; Docker usa 8080.
PORT=8080
